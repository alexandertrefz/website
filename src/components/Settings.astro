<script>
	import { atom, computed } from "nanostores"
	import { persistentAtom } from "@nanostores/persistent"

	type Theme = "dark" | "light"
	type ThemeOptions = Theme | "automatic"

	type AlignmentOptions = "left" | "justify" | "right"

	const alignment = persistentAtom<AlignmentOptions>(
		"alignment",
		"left",
	)

	const selectedTheme = persistentAtom<ThemeOptions>(
		"selectedTheme",
		"automatic",
	)

	// Seed synchronously so the first theme resolution honours the OS
	// preference instead of defaulting to light until the media query is
	// read later.
	const prefersLightQuery = window.matchMedia("(prefers-color-scheme: light)")

	const getDetectedTheme = (): Theme =>
		prefersLightQuery.matches ? "light" : "dark"

	const detectedTheme = atom<Theme>(getDetectedTheme())

	prefersLightQuery.addEventListener("change", () => {
		detectedTheme.set(getDetectedTheme())
	})

	const resolvedTheme = computed(
		[selectedTheme, detectedTheme],
		($selectedTheme, $detectedTheme) => {
			if ($selectedTheme === "automatic") {
				return $detectedTheme
			} else {
				return $selectedTheme
			}
		},
	)

	const fontSize = persistentAtom<string>("fontSize", "16px")

	const FONT_SIZE_MIN = 14
	const FONT_SIZE_MAX = 20

	// The persisted value comes straight from localStorage, so it can be
	// corrupted or stale — clamp it into the supported range instead of
	// ending up with --base-font-size: NaNpx.
	const sanitizeFontSize = (value: string): string => {
		const parsed = parseInt(value)

		if (Number.isNaN(parsed)) {
			return "16px"
		}

		return `${Math.min(Math.max(parsed, FONT_SIZE_MIN), FONT_SIZE_MAX)}px`
	}

	fontSize.set(sanitizeFontSize(fontSize.get()))

	const setAlignmentGlobally = (
		alignment: string,
		documentElement = document.documentElement,
	) => {
		documentElement.style.setProperty("--alignment", alignment)
	}

	const setFontSizeGlobally = (
		fontSize: string,
		documentElement = document.documentElement,
	) => {
		documentElement.style.setProperty("--base-font-size", fontSize)
	}

	const updateDomForResolvedTheme = ($resolvedTheme: string) => {
		const pageContainer = document.documentElement

		pageContainer.classList.add("theme-change")

		requestAnimationFrame(() => {
			pageContainer.classList.remove("light-theme")
			pageContainer.classList.remove("dark-theme")
			pageContainer.classList.add(`${$resolvedTheme}-theme`)

			// NOTE: Disabled as it causes a flicker when we the theme is forced.
			// Set theme-color for Safari UI matching
			// requestAnimationFrame(() => {
			// 	document
			// 		.querySelectorAll("meta[name=theme-color]")
			// 		.forEach((meta) => {
			// 			meta.setAttribute(
			// 				"content",
			// 				getComputedStyle(pageContainer)
			// 					.getPropertyValue(
			// 						"--color-background-offset-close",
			// 					)
			// 					.trim(),
			// 			)
			// 		})
			// })

			setTimeout(() => {
				pageContainer.classList.remove("theme-change")
			}, 375)
		})
	}

	// Module-level subscriptions run exactly once per real page load; their
	// immediate first call applies the persisted settings.
	alignment.subscribe((newAlignment) => setAlignmentGlobally(newAlignment))
	fontSize.subscribe((newFontSize) =>
		setFontSizeGlobally(sanitizeFontSize(newFontSize)),
	)

	let isFirstThemeResolve = true

	resolvedTheme.subscribe(($resolvedTheme) => {
		if (isFirstThemeResolve || !document.startViewTransition) {
			isFirstThemeResolve = false
			updateDomForResolvedTheme($resolvedTheme)
		} else {
			// Set class before we start View Transition,
			// to prevent issues with other view transition elements
			document.documentElement.classList.add("theme-change")
			document.startViewTransition(() => {
				updateDomForResolvedTheme($resolvedTheme)
			})
		}
	})

	// Ensure everything is set correctly early, so that view transitions don't flicker
	document.addEventListener("astro:before-swap", (event) => {
		let newDocumentElement = (event as any).newDocument.documentElement

		setAlignmentGlobally(alignment.get(), newDocumentElement)
		setFontSizeGlobally(fontSize.get(), newDocumentElement)

		newDocumentElement.classList.remove("light-theme")
		newDocumentElement.classList.remove("dark-theme")
		newDocumentElement.classList.add(`${resolvedTheme.get()}-theme`)
		newDocumentElement.classList.add("loaded")
	})

	const settingsFlyoutState = atom<"open" | "closed">("closed")

	let settingsTrigger: HTMLButtonElement | undefined

	document.documentElement.addEventListener("click", (_event) => {
		settingsFlyoutState.set("closed")
	})

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && settingsFlyoutState.get() === "open") {
			settingsFlyoutState.set("closed")
			settingsTrigger?.focus()
		}
	})

	// The settings DOM is replaced on every ClientRouter navigation, so the
	// bindings below are re-created per page — and the store subscriptions
	// from the previous page must be released first, or they would
	// accumulate on every navigation.
	let releasePageBindings: Array<() => void> = []

	document.addEventListener("astro:page-load", () => {
		for (const release of releasePageBindings) release()
		releasePageBindings = []

		settingsFlyoutState.set("closed")

		const settingsContainer = document.querySelector("#settingsContainer")!
		const trigger = settingsContainer.querySelector(
			".trigger",
		) as HTMLButtonElement
		settingsTrigger = trigger
		const settingsFlyout = settingsContainer.querySelector(
			".settings",
		) as HTMLButtonElement
		const closeButton = settingsContainer.querySelector(
			".header .close",
		) as HTMLButtonElement
		const settingsContent = settingsContainer.querySelector(".content")!

		releasePageBindings.push(
			settingsFlyoutState.subscribe(($settingsFlyoutState) => {
				if ($settingsFlyoutState === "open") {
					trigger.setAttribute("aria-expanded", "true")
					settingsFlyout.removeAttribute("hidden")
					requestAnimationFrame(() => {
						settingsContainer.classList.add("open")
						settingsFlyout.classList.add("open")
					})
				} else {
					trigger.setAttribute("aria-expanded", "false")
					settingsContainer.classList.remove("open")
					settingsFlyout.classList.remove("open")
					setTimeout(() => {
						settingsFlyout.setAttribute("hidden", "")
					}, 200)
				}
			}),
		)

		settingsContainer.addEventListener("click", (event) => {
			event.stopPropagation()
		})

		settingsContainer.addEventListener("focusout", (event) => {
			let relatedTarget = (event as FocusEvent).relatedTarget

			if (relatedTarget) {
				if (!settingsContainer.contains(relatedTarget as Node)) {
					settingsFlyoutState.set("closed")
				}
			}
		})

		// The trigger exposes aria-expanded, so it must behave as a
		// toggle — clicking it while the flyout is open closes it again.
		trigger.addEventListener("click", () => {
			if (settingsFlyoutState.get() === "open") {
				settingsFlyoutState.set("closed")
			} else {
				settingsFlyoutState.set("open")
				closeButton.focus()
			}
		})

		closeButton.addEventListener("click", () => {
			settingsFlyoutState.set("closed")
			trigger.focus()
		})

		// Font Size
		{
			const fontSettings =
				settingsContent.querySelector(".setting.fontSize")!
			const reduceButton = fontSettings.querySelector(
				"button.reduce",
			) as HTMLButtonElement
			const label = fontSettings.querySelector(".label")!
			const increaseButton = fontSettings.querySelector(
				"button.increase",
			) as HTMLButtonElement

			releasePageBindings.push(
				fontSize.subscribe(($fontSize) => {
					const sanitized = sanitizeFontSize($fontSize)
					const $fontSizeInteger = parseInt(sanitized)

					label.textContent = sanitized

					if ($fontSizeInteger <= FONT_SIZE_MIN) {
						reduceButton.disabled = true
					} else {
						reduceButton.disabled = false
					}

					if ($fontSizeInteger >= FONT_SIZE_MAX) {
						increaseButton.disabled = true
					} else {
						increaseButton.disabled = false
					}
				}),
			)

			reduceButton.addEventListener("click", () => {
				fontSize.set(
					sanitizeFontSize(
						`${parseInt(sanitizeFontSize(fontSize.get())) - 1}px`,
					),
				)
			})

			increaseButton.addEventListener("click", () => {
				fontSize.set(
					sanitizeFontSize(
						`${parseInt(sanitizeFontSize(fontSize.get())) + 1}px`,
					),
				)
			})
		}

		// Alignment
		{
			const alignmentSettings =
				settingsContent.querySelector(".setting.alignment")!
			const leftButton = alignmentSettings.querySelector("button.left")!
			const justifyButton =
				alignmentSettings.querySelector("button.justify")!
			const rightButton = alignmentSettings.querySelector("button.right")!

			const alignmentButtons = {
				left: leftButton,
				justify: justifyButton,
				right: rightButton,
			}

			releasePageBindings.push(
				alignment.subscribe(($alignment) => {
					for (const [value, button] of Object.entries(
						alignmentButtons,
					)) {
						const isActive = value === $alignment
						button.classList.toggle("active", isActive)
						button.setAttribute(
							"aria-pressed",
							isActive ? "true" : "false",
						)
					}
				}),
			)

			leftButton.addEventListener("click", () => {
				alignment.set("left")
			})

			justifyButton.addEventListener("click", () => {
				alignment.set("justify")
			})

			rightButton.addEventListener("click", () => {
				alignment.set("right")
			})
		}

		// Theme
		{
			const themeSettings =
				settingsContent.querySelector(".setting.theme")!
			const lightButton = themeSettings.querySelector("button.light")!
			const automaticButton =
				themeSettings.querySelector("button.automatic")!
			const darkButton = themeSettings.querySelector("button.dark")!

			const themeButtons = {
				light: lightButton,
				automatic: automaticButton,
				dark: darkButton,
			}

			releasePageBindings.push(
				selectedTheme.subscribe(($theme) => {
					for (const [value, button] of Object.entries(
						themeButtons,
					)) {
						const isActive = value === $theme
						button.classList.toggle("active", isActive)
						button.setAttribute(
							"aria-pressed",
							isActive ? "true" : "false",
						)
					}
				}),
			)

			lightButton.addEventListener("click", () => {
				selectedTheme.set("light")
			})

			automaticButton.addEventListener("click", () => {
				selectedTheme.set("automatic")
			})

			darkButton.addEventListener("click", () => {
				selectedTheme.set("dark")
			})
		}
	})
</script>

<style lang="scss">
	// Icon colour on the accent `active` button fill (--color-highlight-medium).
	// This is the light-theme value of --color-background-offset-furthest
	// and deliberately does not flip with the theme — the accent fill it
	// sits on stays the same in both themes.
	$icon-on-accent: oklch(0.88 0.01 264);

	#settingsContainer {
		font-family: var(--font-settings);
		position: relative;

		user-select: none;

		z-index: 1;

		.settings {
			opacity: 0;
			pointer-events: none;
			user-select: none;

			&.open {
				opacity: 1;
				pointer-events: unset;
				user-select: unset;
			}

			position: absolute;

			top: -13px;
			right: -8px;

			border-radius: 10px;
			background-color: var(--color-background);
			border: 2px solid var(--color-background-offset-furthest);

			transition:
				opacity linear 200ms,
				background-color linear 200ms,
				border-color linear 200ms;

			.header {
				display: grid;
				grid-auto-flow: column;
				justify-content: space-between;

				padding: 20px;
				border-bottom: 2px solid var(--color-background-offset-furthest);

				font-weight: 400;
				font-size: 16px;
				height: 60px;

				transition: border-color linear 200ms;

				.close {
					display: grid;
					align-self: center;
					height: 38px;
					width: 38px;
					margin: -12px;
					border-radius: 5px;
					cursor: pointer;

					touch-action: manipulation;

					transition: background-color linear 200ms;
					background-color: var(--color-background-offset);
					border: none;

					&:hover {
						background-color: var(
							--color-background-offset-further
						);
					}

					svg {
						align-self: center;
						justify-self: center;
						fill: var(--color-foreground);

						transition: all linear 200ms;
					}

					&:focus-visible {
						outline: none;
						box-shadow: none;
						border: 2px solid var(--color-highlight-intense);
					}
				}
			}

			.content {
				display: grid;
				gap: 20px;

				padding: 20px;

				font-weight: 500;
				font-size: 15px;

				.setting {
					.headline {
						padding-bottom: 6px;
					}

					button {
						display: grid;
						width: 50px;
						height: 38px;
						background-color: var(--color-background-offset);
						border-radius: 5px;
						border: none;

						transition: background-color linear 200ms;

						touch-action: manipulation;

						&:disabled {
							opacity: 0.8;

							svg {
								opacity: 0.3;
							}
						}

						&:hover {
							background-color: var(
								--color-background-offset-further
							);
						}

						&.active {
							background-color: var(--color-highlight-medium);

							svg {
								path {
									fill: $icon-on-accent;
								}

								circle {
									stroke: $icon-on-accent;
								}
							}
						}

						&:not(.active):hover {
							cursor: pointer;
						}

						&:focus-visible {
							outline: none;
							box-shadow: none;
							// Drive the focus ring from the highest-contrast
							// foreground colour rather than the accent. The
							// accent (--color-highlight-intense) matches the
							// active button fill (--color-highlight-medium), so
							// an accent ring would disappear against an adjacent
							// active button in the tightly-packed control groups.
							border: 2px solid var(--color-foreground-emphasis);

							&.active {
								background: var(--color-highlight-medium);
								// The active fill is dark while the dialog around
								// it is light (and vice-versa in dark theme), so
								// the single-tone border can only contrast with
								// one edge. Add an inner separator in the dialog
								// background colour to keep the ring crisp
								// against the fill as well.
								box-shadow: inset 0 0 0 2px $icon-on-accent;
							}
						}

						svg {
							align-self: center;
							justify-self: center;
							transition: all linear 200ms;

							circle {
								stroke: var(--color-foreground-emphasis);
								transition: all linear 200ms;
							}

							path {
								fill: var(--color-foreground-emphasis);
								transition: all linear 200ms;
							}
						}
					}

					.label {
						text-align: center;
						width: 50px;
						height: 38px;
						line-height: 38px;
					}

					.controlGroup {
						display: grid;
						grid-auto-flow: column;
						gap: 1px;

						&.buttonsOnly {
							button:first-child {
								border-top-right-radius: 0px;
								border-bottom-right-radius: 0px;
							}

							button:nth-child(2) {
								border-radius: 0px;
							}

							button:last-child {
								border-top-left-radius: 0px;
								border-bottom-left-radius: 0px;
							}
						}
					}
				}
			}
		}
	}
</style>

