---
export interface Props {
	readingTime: number
	pubDate: string
	slug: string
}

const { readingTime, pubDate, slug } = Astro.props

const readingTimeDate = new Date(pubDate)
---

<div class="metadata" transition:name={`metadata-${slug}`}>
	<span class="readingTime">
		<strong>{readingTime}</strong>
		Minute Read
	</span>
	{/* Date-only strings parse as UTC midnight, so format in UTC too —
	    otherwise a build machine west of UTC renders the previous month. */}
	<time datetime={pubDate}>
		{
			new Intl.DateTimeFormat("en-GB", {
				month: "long",
				timeZone: "UTC",
			}).format(readingTimeDate)
		}

		<strong>
			{
				new Intl.DateTimeFormat("en-GB", {
					year: "numeric",
					timeZone: "UTC",
				}).format(readingTimeDate)
			}
		</strong>
	</time>
</div>

<style lang="scss">
	.metadata {
		font-family: var(--font-article-metadata);
		font-size: calc(var(--base-font-size) - 2px);
		font-weight: 500;

		font-feature-settings: "cpsp";
		text-transform: uppercase;

		display: inline-grid;
		grid-auto-flow: column;
		gap: 20px;

		user-select: none;

		strong {
			font-weight: 600;
		}

		.readingTime {
			strong::after {
				content: " ";
			}
		}

		time {
			strong::before {
				content: " ";
			}
		}
	}
</style>
