---
import BaseLayout from "@layouts/BaseLayout.astro"
import Headline from "@components/Headline.astro"
---

<BaseLayout
	title="Page Not Found – alexander.trefz.me"
	description="This page does not exist."
>
	<article class="notFound">
		<Headline>Page Not Found</Headline>
		<p>
			The page you are looking for does not exist — it may have been moved
			or removed.
		</p>
		<p>
			You can head over to <a href="/blog/">the blog</a> or read more
			<a href="/about/">about me</a>.
		</p>
	</article>
</BaseLayout>

<style lang="scss">
	.notFound {
		display: grid;
		gap: 30px;

		justify-self: center;
		max-width: var(--content-width);

		p {
			font-variant-numeric: lining-nums;
			font-family: var(--font-article-text);
			font-size: calc(var(--base-font-size) + 1px);
			line-height: 1.3;
			text-align: var(--alignment);
		}
	}
</style>
