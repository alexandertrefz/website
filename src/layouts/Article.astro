---
import type { CollectionEntry } from "astro:content"

import BaseLayout from "@layouts/BaseLayout.astro"
import Metadata from "@components/Metadata.astro"

export interface Props {
	content: CollectionEntry<"blog">["data"]
}

const {
	content: { title, description, readingTime, pubDate },
} = Astro.props

// Derive the slug from the URL rather than trusting a frontmatter field —
// the transition names built from it must match the ones the blog listing
// derives from the entry id, and both come from the filename.
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? ""
---

<BaseLayout title={title} description={description} pubDate={pubDate}>
	<article>
		<div class="title">
			<h1 transition:name={`title-${slug}`}>{title}</h1>
			<Metadata readingTime={readingTime} pubDate={pubDate} slug={slug} />
		</div>

		<section>
			<slot />
		</section>
	</article>

	<script>
		const SCOPE_KEY = "astroTransitionScope"
		const STASH_KEY = "stashedTransitionScope"

		// Read (and consume) the VT state recorded by BaseLayout's
		// always-loaded script. We can't track it here because this
		// script doesn't exist on the *source* page of a VT navigation,
		// so the before-preparation event would already be gone by the
		// time we'd attach a listener.
		function consumeVTState() {
			const state = (window as any).__articleVT as
				| {
						navigation: boolean
						finished: Promise<unknown> | null
				  }
				| undefined
			if (!state) return { isVT: false, finished: null }
			const result = {
				isVT: state.navigation,
				finished: state.finished,
			}
			state.navigation = false
			state.finished = null
			return result
		}

		// Disable view-transition scopes on elements that are off-screen, so
		// only what the user is actually looking at participates in the morph
		// when navigating back to the list.
		function trackScopeVisibility() {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						const el = entry.target
						if (!(el instanceof HTMLElement)) continue
						const data = el.dataset

						if (entry.isIntersecting) {
							if (data[STASH_KEY]) {
								data[SCOPE_KEY] = data[STASH_KEY]
							}
						} else if (data[SCOPE_KEY]) {
							data[STASH_KEY] = data[SCOPE_KEY]
							delete data[SCOPE_KEY]
						}
					}
				},
				// Observe against the viewport (the page scrolls on the
				// window, not on `main`). Using `main` as the root would
				// keep the title "intersecting" forever — it's always
				// inside main's box — so the off-screen headline would
				// still join the morph and fly in from the top.
				{ root: null, threshold: 0.2 },
			)

			for (const el of document.querySelectorAll(
				"[data-astro-transition-scope]",
			)) {
				observer.observe(el)
			}
		}

		// Run the staggered fade-up via the Web Animations API. Using
		// WAAPI (instead of CSS keyframes + class toggle) avoids restarts
		// from style recomputation and side-steps the global
		// `html:not(.loaded) *` rule that zeroes animation durations.
		function staggerEntries(
			isVT: boolean,
			vtFinished: Promise<unknown> | null,
		) {
			const article = document.querySelector("article")
			if (!article) return

			const reduceMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches

			if (reduceMotion) {
				article.classList.add("paragraphs-ready")
				return
			}

			const titleItems = isVT
				? []
				: Array.from(article.querySelectorAll(":scope > .title > *"))
			const bodyItems = Array.from(
				article.querySelectorAll(
					":scope > section > p, :scope > section > h2",
				),
			)
			const items = [...titleItems, ...bodyItems]

			// Promote the animating elements to their own layers right
			// away. On the VT path this gives the compositor the entire
			// view-transition duration to warm the layers, so the stagger
			// doesn't stutter when it starts amid the VT teardown.
			for (const el of items) {
				if (el instanceof HTMLElement) {
					el.style.willChange = "transform, opacity"
				}
			}

			// Delay each item by STEP_MS more than the previous one, but
			// cap the ramp at STAGGER_CAP items so a long article's tail
			// doesn't trickle in forever — everything beyond the cap moves
			// as one group.
			const STAGGER_CAP = 20
			const STEP_MS = 35
			// On a fresh load the title is item 0 of the stagger and
			// needs a small lead-in. On a VT navigation the title is
			// being morphed by the VT itself; we wait for that to
			// finish before kicking off the body stagger, so a 0ms
			// lead means the body starts the instant the title settles.
			const LEAD_MS = isVT ? 0 : 250

			const start = () => {
				// Kick off WAAPI animations first so they own the
				// initial frame, then lift the static hidden state.
				// Split the move and the fade into two animations so
				// the vertical motion can be punchier than the fade.
				items.forEach((el, i) => {
					if (!(el instanceof HTMLElement)) return
					const delay = Math.min(i, STAGGER_CAP) * STEP_MS + LEAD_MS

					el.animate(
						[
							{ transform: "translateY(20px)" },
							{ transform: "translateY(0)" },
						],
						{
							duration: 300,
							delay,
							easing: "ease",
							fill: "backwards",
						},
					)
					const fade = el.animate([{ opacity: 0 }, { opacity: 1 }], {
						duration: 1000,
						delay,
						easing: "cubic-bezier(0.16, 1, 0.3, 1)",
						fill: "backwards",
					})
					fade.finished
						.then(() => {
							el.style.willChange = ""
						})
						.catch(() => {})
				})
				article.classList.add("paragraphs-ready")
			}

			// If `loaded` never shows up (e.g. the script that sets it
			// died), give up waiting after ~5s of frames and reveal
			// anyway rather than spinning a rAF loop forever over
			// invisible content.
			const MAX_WAIT_FRAMES = 300

			const waitForLoaded = (extraFrame = false, frames = 0) => {
				if (
					document.documentElement.classList.contains("loaded") ||
					frames > MAX_WAIT_FRAMES
				) {
					if (extraFrame) {
						// Let the VT teardown recomposite (which happens on
						// the frame the snapshots are removed) finish before
						// we start, so the first item's transform doesn't
						// stutter against it.
						requestAnimationFrame(() =>
							requestAnimationFrame(start),
						)
					} else {
						requestAnimationFrame(start)
					}
				} else {
					requestAnimationFrame(() =>
						waitForLoaded(extraFrame, frames + 1),
					)
				}
			}

			if (isVT && vtFinished) {
				// The live DOM only becomes visible exactly when the view
				// transition finishes — starting any earlier runs the
				// stagger invisibly behind the VT snapshots. So trigger
				// off vt.finished and give it one extra frame to let the
				// snapshot teardown settle.
				vtFinished.then(
					() => waitForLoaded(true),
					() => waitForLoaded(true),
				)
			} else {
				waitForLoaded()
			}
		}

		const reveal = () => {
			const { isVT, finished } = consumeVTState()
			trackScopeVisibility()
			staggerEntries(isVT, finished)
		}

		// Reveal as soon as this module executes instead of waiting for
		// astro:page-load — on a fresh load that event only fires at
		// window `load`, so a single slow asset would keep the whole
		// article invisible until it finished downloading.
		reveal()

		// The astro:page-load for the navigation that pulled this module
		// in fires right after module execution; skip it so the reveal
		// above isn't immediately re-run.
		let skipNextPageLoad = true

		document.addEventListener("astro:page-load", () => {
			if (skipNextPageLoad) {
				skipNextPageLoad = false
				return
			}

			reveal()
		})
	</script>
</BaseLayout>

<style lang="scss">
	@use "../styles/mixins" as *;

	article {
		display: grid;
		justify-self: center;
		max-width: var(--content-width);
		gap: 30px;
	}

	.title {
		display: grid;
		justify-items: center;
		gap: 10px;
	}

	h1 {
		font-family: var(--font-article-title);
		font-size: calc(var(--base-font-size) * 1.65);
		font-weight: 400;
		text-align: center;
		line-height: 1.3;
	}

	section {
		font-variant-numeric: lining-nums;
		font-family: var(--font-text);
		font-size: var(--base-font-size);
	}

	section :global(p) {
		padding-bottom: 25px;
		line-height: 1.4;
		text-align: var(--alignment);
		text-wrap: pretty;
	}

	section :global(p):last-child {
		padding-bottom: 0px;
	}

	// Pre-hide entries when JS is available so WAAPI can drive their
	// fade-up cleanly. The `.paragraphs-ready` class is added by the
	// script before the animation starts, so this rule only applies in
	// the brief window between DOM insertion and animation arming.
	//
	// The title block is excluded when `.vt-nav` is set (i.e. this load
	// was a view-transition navigation), because the title + metadata
	// are handled by the VT in that case and shouldn't be hidden.
	:global(html.loaded)
		article:not(.paragraphs-ready):not(.vt-nav)
		.title
		> :global(*),
	:global(html.loaded) article:not(.paragraphs-ready) section :global(p),
	:global(html.loaded) article:not(.paragraphs-ready) section :global(h2) {
		opacity: 0;
		transform: translateY(20px);
		will-change: opacity, transform;
		// Failsafe: if the reveal script never adds `.paragraphs-ready`
		// (it threw, or its chunk failed to load), fade the content in
		// after a grace period instead of leaving the article invisible.
		animation: reveal-failsafe 300ms ease 3s forwards;
	}

	:global(html.loaded) article:not(.paragraphs-ready) section::after {
		opacity: 0;
		animation: reveal-failsafe 300ms ease 3s forwards;
	}

	@keyframes reveal-failsafe {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	section :global(h2) {
		padding-top: 15px;
		padding-bottom: 15px;
		font-family: var(--font-article-title);
		font-size: calc(var(--base-font-size) * 1.25);
		font-weight: 400;
		text-align: center;
		font-style: italic;
		line-height: 1.4;
	}

	section :global(a) {
		// Deliberately not inline-block: that would stop long links from
		// wrapping across lines, forcing them onto their own block at
		// narrow viewports.
		position: relative;
		font-weight: 500;
		color: var(--color-highlight-intense);
		text-decoration-color: transparent;

		transition: text-decoration-color 200ms linear;

		@include focus-ring(-3px -6px, 3px);

		&:hover {
			text-decoration-color: var(--color-highlight-intense);
		}
	}

	section :global(em) {
		color: var(--color-foreground-emphasis);
		font-style: italic;
	}

	section :global(strong) {
		color: var(--color-foreground-emphasis);
		font-weight: 600;
	}

	section :global(.subtle) {
		color: var(--color-foreground-medium);
	}

	section :global(code) {
		font-family: var(--font-berkeley-mono);
		font-weight: 400;
		font-style: normal;
	}

	section::after {
		content: "";
		display: block;
		width: 120px;
		height: 19px;
		margin: 50px auto;
		background-color: var(--color-background-offset-furthest);
		mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 90 14' fill='black'><path d='M4 7 L7 4 L10 7 L7 10 Z' opacity='0.7'/><path d='M21 7 L25 3 L29 7 L25 11 Z' opacity='0.85'/><path d='M40 7 L45 2 L50 7 L45 12 Z'/><path d='M61 7 L65 3 L69 7 L65 11 Z' opacity='0.85'/><path d='M80 7 L83 4 L86 7 L83 10 Z' opacity='0.7'/></svg>");
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
	}

	// Fade the end mark in during the tail of the body stagger. The
	// stagger's last item settles at
	// STAGGER_CAP(20) * STEP_MS(35) + LEAD_MS + fade duration(1000)
	// — ~1950ms on a fresh load (LEAD_MS=250), ~1700ms on a VT
	// navigation (LEAD_MS=0) — while this 700ms fade runs from 800ms
	// (fresh) or 1000ms (VT), so the mark lands together with the
	// cascade's final items rather than trailing after them.
	article.paragraphs-ready section::after {
		animation: end-mark-in 700ms cubic-bezier(0.16, 1, 0.3, 1) 800ms
			backwards;
	}

	article.vt-nav.paragraphs-ready section::after {
		animation-delay: 1000ms;
	}

	@media (prefers-reduced-motion: reduce) {
		article.paragraphs-ready section::after {
			animation: none;
		}
	}

	@keyframes end-mark-in {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
